# Server Port
PORT=3000

# MongoDB Connection String (optional; in-memory fallback will activate if MongoDB is offline)
# Example local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/devbrain
# Example MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/devbrain?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here
